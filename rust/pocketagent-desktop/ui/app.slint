import { Button, ComboBox, GroupBox, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";

export struct MarkdownBlock {
    text: string,
    kind: string,
    has-image: bool,
    image: image,
}

export struct SessionItem {
    id: string,
    title: string,
}

export struct HostDeviceItem {
    id: string,
    name: string,
    authorized: bool,
}

export struct ScheduledItem {
    id: string,
    text: string,
    due-at: string,
    status: string,
}

export component AppWindow inherits Window {
    title: "PocketAgent Rust Desktop";
    preferred-width: 820px;
    preferred-height: 680px;
    min-width: 640px;
    min-height: 480px;

    in-out property <string> repository-path: "";
    in-out property <string> codex-executable: "codex";
    in-out property <string> codex-status: "Codex is disconnected";
    in-out property <string> work-timing: "";
    in-out property <[SessionItem]> session-items: [];
    in-out property <string> current-session-id: "";
    in-out property <string> current-working-directory: "";
    in-out property <string> selected-model: "";
    in-out property <string> selected-effort: "";
    in-out property <bool> showing-archived: false;
    in-out property <string> pending-interaction: "";
    in-out property <string> interaction-method: "";
    in-out property <string> interaction-decisions: "";
    in-out property <string> model-catalog: "Provider model catalog unavailable";
    in-out property <[string]> model-options: [""];
    in-out property <string> usage-summary: "Usage unavailable";
    in-out property <[MarkdownBlock]> transcript-blocks: [];
    in-out property <string> relay-status: "Relay is stopped";
    in-out property <string> relay-endpoint: "No endpoint";
    in-out property <bool> relay-running: false;
    in-out property <string> relay-host-status: "Outbound host connection is not configured";
    in-out property <bool> relay-host-connected: false;
    in-out property <string> host-status: "Host API is stopped";
    in-out property <string> host-endpoint: "No host endpoint";
    in-out property <string> host-pairing: "Pairing code unavailable";
    in-out property <[HostDeviceItem]> host-devices: [];
    in-out property <[ScheduledItem]> scheduled-items: [];
    callback connect-codex(string, string);
    callback new-conversation(string, string, string);
    callback refresh-sessions();
    callback select-session(string);
    callback archive-session();
    callback restore-session();
    callback toggle-pin();
    callback rename-session(string);
    callback toggle-archived();
    callback answer-interaction(string);
    callback send-prompt(string, string, string);
    callback schedule-prompt(string, string, string, string);
    callback stop-work();
    callback start-relay(string);
    callback stop-relay();
    callback connect-relay-host(string, string, string, string);
    callback disconnect-relay-host();
    callback set-device-access(string, string, bool);
    callback cancel-schedule(string);

    background: #18271f;

    VerticalBox {
        padding: 28px;
        spacing: 18px;

        Text {
            text: "PocketAgent";
            color: #c1daa6;
            font-size: 30px;
            font-weight: 700;
        }
        Text {
            text: "Local desktop mode";
            color: #a7b7aa;
            font-size: 16px;
        }

        GroupBox {
            title: "Codex connection";
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                HorizontalBox {
                    spacing: 8px;
                    repository := LineEdit { text: repository-path; edited => { repository-path = self.text; } }
                    executable := LineEdit { text: codex-executable; edited => { codex-executable = self.text; } }
                    Button {
                        text: "Connect Codex";
                        clicked => { connect-codex(repository.text, executable.text); }
                    }
                }
                Text { text: codex-status; color: #c1daa6; font-size: 14px; }
                Text { text: usage-summary; color: #a7b7aa; font-size: 13px; }
            }
        }

        GroupBox {
            title: "Sessions";
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                for session in session-items : Button {
                    text: session.title;
                    clicked => { select-session(session.id); }
                }
                HorizontalBox {
                    spacing: 8px;
                    new-folder := LineEdit { placeholder-text: "Working folder (optional)"; }
                    Button { text: "New conversation"; enabled: codex-status == "Codex is ready"; clicked => { new-conversation(model.current-value, effort.text, new-folder.text); new-folder.text = ""; } }
                    Button { text: "Refresh"; enabled: codex-status == "Codex is ready"; clicked => { refresh-sessions(); } }
                    Button { text: showing-archived ? "Active" : "Archived"; clicked => { toggle-archived(); } }
                    Button { text: "Pin / unpin"; enabled: current-session-id != ""; clicked => { toggle-pin(); } }
                    Button { text: showing-archived ? "Restore" : "Archive"; enabled: current-session-id != ""; clicked => { if (showing-archived) { restore-session(); } else { archive-session(); } } }
                }
                HorizontalBox {
                    spacing: 8px;
                    rename := LineEdit { placeholder-text: "Rename selected conversation"; }
                    Button { text: "Rename"; enabled: current-session-id != "" && rename.text != ""; clicked => { rename-session(rename.text); rename.text = ""; } }
                }
            }
        }

        GroupBox {
            title: "Conversation";
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                for block in transcript-blocks : Rectangle {
                    background: transparent;
                    if block.has-image : Image {
                        source: block.image;
                        image-fit: contain;
                        max-width: 640px;
                        max-height: 480px;
                    }
                    if !block.has-image : Text {
                        text: block.text;
                        color: block.kind == "code" ? #c1daa6 : #e8f1e6;
                        font-size: block.kind == "heading" ? 18px : 14px;
                        font-weight: block.kind == "heading" ? 700 : 400;
                        font-family: block.kind == "code" ? "Consolas" : "Segoe UI";
                        wrap: word-wrap;
                    }
                }
                if interaction-method != "" : GroupBox {
                    title: "Codex needs your input";
                    VerticalBox {
                        spacing: 8px;
                        Text { text: pending-interaction; color: #f3d28a; font-size: 14px; }
                        response := LineEdit { placeholder-text: interaction-method == "item/tool/requestUserInput" ? "One answer per line" : "Decision"; }
                        HorizontalBox {
                            spacing: 8px;
                            if interaction-method == "item/tool/requestUserInput" : Button { text: "Submit"; enabled: response.text != ""; clicked => { answer-interaction(response.text); response.text = ""; } }
                            if interaction-method != "item/tool/requestUserInput" : Button { text: "Accept"; clicked => { answer-interaction("accept"); } }
                            if interaction-method != "item/tool/requestUserInput" : Button { text: "Decline"; clicked => { answer-interaction("decline"); } }
                            if interaction-method != "item/tool/requestUserInput" : Button { text: "Cancel"; clicked => { answer-interaction("cancel"); } }
                        }
                    }
                }
                HorizontalBox {
                    spacing: 8px;
                    Text { text: codex-status; color: #c1daa6; font-size: 13px; vertical-alignment: center; }
                    Text { text: work-timing; color: #8fa294; font-size: 12px; vertical-alignment: center; }
                    Text { text: current-session-id == "" ? "No conversation selected" : current-working-directory; color: #8fa294; font-size: 12px; vertical-alignment: center; overflow: elide; }
                }
                HorizontalBox {
                    spacing: 8px;
                    model := ComboBox { model: model-options; current-value: selected-model; selected(value) => { selected-model = value; } }
                    effort := LineEdit { text: selected-effort; placeholder-text: "Reasoning effort (optional)"; edited => { selected-effort = self.text; } }
                }
                Text { text: model-catalog; color: #8fa294; font-size: 12px; wrap: word-wrap; }
                HorizontalBox {
                    spacing: 8px;
                    prompt := LineEdit {
                        placeholder-text: codex-status == "Codex is working..." ? "Steer the active turn" : "Send a prompt";
                        enabled: codex-status == "Codex is ready" || codex-status == "Codex is working...";
                    }
                    Button {
                        text: "Send";
                        enabled: (codex-status == "Codex is ready" || codex-status == "Codex is working...") && prompt.text != "";
                        clicked => { send-prompt(prompt.text, model.current-value, effort.text); }
                    }
                    if codex-status == "Codex is working..." : Button {
                        text: "Stop";
                        clicked => { stop-work(); }
                    }
                }
                HorizontalBox {
                    spacing: 8px;
                    delay := LineEdit { placeholder-text: "Delay seconds"; }
                    Button {
                        text: "Schedule";
                        enabled: codex-status == "Codex is ready" && prompt.text != "" && delay.text != "";
                        clicked => { schedule-prompt(prompt.text, model.current-value, effort.text, delay.text); prompt.text = ""; delay.text = ""; }
                    }
                }
                if scheduled-items.length > 0 : GroupBox {
                    title: "Scheduled messages";
                    VerticalBox {
                        spacing: 6px;
                        for item in scheduled-items : HorizontalBox {
                            spacing: 8px;
                            Text { text: item.text; color: #e8f1e6; overflow: elide; }
                            Text { text: item.due-at; color: #8fa294; overflow: elide; }
                            Text { text: item.status; color: #a7b7aa; }
                            Button {
                                text: "Cancel";
                                enabled: item.status == "pending";
                                clicked => { cancel-schedule(item.id); }
                            }
                        }
                    }
                }
            }
        }

        GroupBox {
            title: "Optional relay";
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                Text { text: relay-status; color: #a7b7aa; font-size: 13px; }
                Text { text: relay-endpoint; color: #c1daa6; font-size: 13px; }
                HorizontalBox {
                    spacing: 8px;
                    relay-bind-field := LineEdit { placeholder-text: "Relay bind address"; text: "127.0.0.1:0"; }
                    Button { text: relay-running ? "Running" : "Start relay"; enabled: !relay-running; clicked => { start-relay(relay-bind-field.text); } }
                    Button { text: "Stop"; enabled: relay-running; clicked => { stop-relay(); } }
                }
                Text { text: relay-host-status; color: #a7b7aa; font-size: 13px; wrap: word-wrap; }
                relay-host-url := LineEdit { placeholder-text: "Relay URL (ws:// or wss://)"; }
                relay-host-id := LineEdit { placeholder-text: "Relay host ID"; }
                relay-host-token := LineEdit { placeholder-text: "Relay host token (not persisted)"; }
                relay-session-key := LineEdit { placeholder-text: "Session key (<uuid>:<64 hex>) (not persisted)"; }
                Button {
                    text: "Connect this desktop through relay";
                    enabled: relay-host-url.text != "" && relay-host-id.text != "" && relay-host-token.text != "" && relay-session-key.text != "";
                    clicked => { connect-relay-host(relay-host-url.text, relay-host-id.text, relay-host-token.text, relay-session-key.text); }
                }
                Button {
                    text: "Disconnect outbound host";
                    enabled: relay-host-connected;
                    clicked => { disconnect-relay-host(); }
                }
            }
        }

        GroupBox {
            title: "Desktop host API";
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                Text { text: host-status; color: #a7b7aa; font-size: 13px; }
                Text { text: host-endpoint; color: #c1daa6; font-size: 13px; }
                Text { text: host-pairing; color: #f3d28a; font-size: 13px; }
                Text { text: current-session-id == "" ? "Select a conversation to manage access." : "Conversation access"; color: #a7b7aa; font-size: 12px; }
                for device in host-devices : Button {
                    text: (device.authorized ? "Remove  " : "Add  ") + device.name;
                    enabled: current-session-id != "";
                    clicked => { set-device-access(current-session-id, device.id, !device.authorized); }
                }
            }
        }

        Text {
            text: "Local Codex mode does not require a relay. The host API is opt-in for remote clients.";
            color: #8fa294;
            font-size: 13px;
        }
    }
}
