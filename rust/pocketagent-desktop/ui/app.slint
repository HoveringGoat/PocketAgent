import { Button, ComboBox, GroupBox, HorizontalBox, LineEdit, ScrollView, TextEdit, VerticalBox } from "std-widgets.slint";

export struct MarkdownBlock {
    text: string,
    kind: string,
    has-image: bool,
    image: image,
}

export struct SessionItem {
    id: string,
    title: string,
    pinned: bool,
}

export struct HostDeviceItem {
    id: string,
    name: string,
    authorized: bool,
}

export struct ScheduledItem {
    id: string,
    conversation-id: string,
    text: string,
    due-at: string,
    status: string,
}

component SessionTab inherits Rectangle {
    in property <string> title;
    in property <bool> selected;
    in property <bool> pinned;
    callback activated();
    width: clamp(label.preferred-width + 24px, 96px, 220px);
    height: 35px;
    border-top-left-radius: 7px;
    border-top-right-radius: 7px;
    background: selected ? #294633 : touch.has-hover ? #203328 : #18271f;
    border-width: 1px;
    border-color: keys.has-focus ? #c1daa6 : #47604b;
    accessible-role: tab;
    accessible-label: label.text;
    accessible-item-selectable: true;
    accessible-item-selected: selected;
    accessible-action-default => { root.activated(); }

    label := Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: (root.pinned ? "Pinned · " : "") + root.title;
        vertical-alignment: center;
        overflow: elide;
        color: root.selected ? #e8f1e6 : #c1daa6;
    }
    Rectangle { y: parent.height - 2px; height: 2px; background: root.selected ? #c1daa6 : transparent; }
    keys := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Return || event.text == " " { root.activated(); return accept; }
            return reject;
        }
    }
    touch := TouchArea { clicked => { keys.focus(); root.activated(); } }
}

export component AppWindow inherits Window {
    title: "PocketAgent Rust Desktop";
    preferred-width: 1150px;
    preferred-height: 820px;
    min-width: 800px;
    min-height: 580px;

    in-out property <string> server-name: "Desktop";
    in-out property <string> repository-path: "";
    in-out property <string> codex-executable: "codex";
    in-out property <string> current-page: "sessions";
    in-out property <string> codex-status: "Codex is disconnected";
    in-out property <bool> codex-available: false;
    in-out property <string> work-timing: "";
    in-out property <[SessionItem]> session-items: [];
    in-out property <string> current-session-id: "";
    in-out property <string> current-working-directory: "";
    in-out property <string> selected-model: "";
    in-out property <string> selected-effort: "";
    in-out property <bool> showing-archived: false;
    in-out property <string> pending-interaction: "";
    in-out property <string> interaction-method: "";
    in-out property <string> interaction-decisions: "";
    in-out property <string> model-catalog: "Provider model catalog unavailable";
    in-out property <[string]> model-options: [""];
    in-out property <string> usage-summary: "Usage unavailable";
    in-out property <[MarkdownBlock]> transcript-blocks: [];
    in-out property <string> relay-status: "Relay is stopped";
    in-out property <string> relay-endpoint: "No endpoint";
    in-out property <string> relay-enrollment: "Relay enrollment is not loaded";
    in-out property <bool> relay-running: false;
    in-out property <string> relay-host-status: "Outbound host connection is not configured";
    in-out property <bool> relay-host-connected: false;
    in-out property <string> host-status: "Host API is stopped";
    in-out property <string> host-endpoint: "No host endpoint";
    in-out property <string> host-pairing: "Pairing code unavailable";
    in-out property <[HostDeviceItem]> host-devices: [];
    in-out property <[ScheduledItem]> scheduled-items: [];
    in-out property <bool> creating-session: false;
    in-out property <string> composer-draft: "";
    in-out property <string> schedule-delay: "";
    in-out property <string> submission-warning: "";
    in-out property <string> new-session-folder: "";
    in-out property <[string]> folder-choices: [];
    property <bool> reviewing-schedules: false;

    callback connect-codex(string, string);
    callback new-conversation(string, string, string);
    callback refresh-sessions();
    callback select-session(string);
    callback archive-session();
    callback restore-session();
    callback toggle-pin();
    callback rename-session(string);
    callback toggle-archived();
    callback answer-interaction(string);
    callback send-prompt(string, string, string);
    callback schedule-prompt(string, string, string, string);
    callback stop-work();
    callback start-relay(string);
    callback stop-relay();
    callback connect-relay-host(string, string, string, string);
    callback disconnect-relay-host();
    callback set-device-access(string, string, bool);
    callback revoke-device(string);
    callback renew-pairing();
    callback cancel-schedule(string);
    callback navigate(string);
    callback switch-draft(string);
    callback browse-folders(string);

    background: #111b17;

    VerticalBox {
        padding: 22px;
        spacing: 0px;

        // Allow the header to grow to fit its title, context, and usage rows.
        HorizontalBox {
            min-height: 68px;
            padding-bottom: 8px;
            spacing: 16px;
            VerticalBox {
                horizontal-stretch: 1;
                spacing: 2px;
                Text { text: "PocketAgent"; color: #c1daa6; font-size: 22px; font-weight: 700; }
                Text {
                    text: server-name + " · " + (current-working-directory == "" ? "No folder selected" : current-working-directory);
                    color: #a7baa7;
                    font-size: 11px;
                    overflow: elide;
                }
                Text { text: usage-summary; color: #c1daa6; font-size: 11px; overflow: elide; }
            }
            HorizontalBox {
                spacing: 4px;
                Button { height: 36px; text: "Sessions"; enabled: current-page != "sessions"; clicked => { navigate("sessions"); } }
                Button { height: 36px; text: "Devices"; enabled: current-page != "devices"; clicked => { navigate("devices"); } }
                Button { height: 36px; text: "Settings"; enabled: current-page != "settings"; clicked => { navigate("settings"); } }
                Rectangle {
                    width: 64px;
                    height: 26px;
                    background: #203328;
                    border-width: 1px;
                    border-color: #47604b;
                    border-radius: 13px;
                    Text { text: host-status == "Host API is running" ? "ON" : "OFF"; color: #c1daa6; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }

        if current-page == "sessions" : VerticalBox {
            vertical-stretch: 1;
            spacing: 12px;

            // Conversation tabs and actions share one row, as in the .NET app.
            HorizontalBox {
                height: 48px;
                padding: 0px;
                spacing: 6px;
                Rectangle {
                    horizontal-stretch: 1;
                    background: #111b17;
                    border-width: 1px;
                    border-color: #20382b;
                    ScrollView {
                        HorizontalBox {
                            padding: 0px;
                            spacing: 3px;
                            accessible-role: tab-list;
                            for session in session-items : SessionTab {
                                title: session.title;
                                selected: session.id == current-session-id;
                                pinned: session.pinned;
                                activated => { select-session(session.id); reviewing-schedules = false; }
                            }
                        }
                    }
                }
                Button {
                    text: "+";
                    clicked => {
                        creating-session = !creating-session;
                        if creating-session { new-session-folder = repository-path; }
                    }
                }
                Button { text: "Edit"; enabled: current-session-id != ""; clicked => { rename-session(rename.text); } }
                Button { text: "Pin / unpin"; enabled: current-session-id != ""; clicked => { toggle-pin(); } }
                Button { text: showing-archived ? "Restore" : "Archive"; enabled: current-session-id != ""; clicked => { if (showing-archived) { restore-session(); } else { archive-session(); } } }
                Button { text: showing-archived ? "Active" : "Archived"; clicked => { toggle-archived(); } }
                rename := LineEdit { width: 180px; placeholder-text: "Rename selected"; visible: current-session-id != ""; }
            }

            if creating-session : GroupBox {
                title: "New conversation";
                VerticalBox {
                    spacing: 6px;
                    HorizontalBox {
                        LineEdit { placeholder-text: "Working folder"; text <=> new-session-folder; }
                        Button { text: "Browse folders"; clicked => { browse-folders(new-session-folder); } }
                    }
                    if folder-choices.length > 0 : ComboBox {
                        model: folder-choices;
                        selected(path) => { if path != "Choose a folder…" { new-session-folder = path; browse-folders(path); } }
                    }
                    new-model := ComboBox { model: model-options; }
                    HorizontalBox {
                        Button { text: "Create conversation"; enabled: codex-available; clicked => { new-conversation(new-model.current-value, "", new-session-folder); } }
                        Button { text: "Cancel"; clicked => { creating-session = false; } }
                    }
                }
            }

            GroupBox {
                title: "Conversation";
                vertical-stretch: 1;
                VerticalBox {
                    padding: 0px;
                    spacing: 0px;
                    Rectangle {
                        vertical-stretch: 1;
                        background: #111b17;
                        border-width: 1px;
                        border-color: #294633;
                        ScrollView {
                            VerticalBox {
                                padding: 12px;
                                spacing: 8px;
                                if transcript-blocks.length == 0 : Text { text: current-session-id == "" ? "Select a conversation" : "Send a message to start working."; color: #c1daa6; font-size: 15px; }
                                for block in transcript-blocks : Rectangle {
                                    horizontal-stretch: 1;
                                    height: block.has-image ? 320px : max(42px, block-text.preferred-height + 24px);
                                    background: block.kind == "code" ? #19271f : #18271f;
                                    border-width: block.kind == "code" ? 1px : 0px;
                                    border-color: #47604b;
                                    border-radius: 7px;
                                    block-text := Text {
                                        x: 12px;
                                        y: 12px;
                                        width: parent.width - 24px;
                                        text: block.text;
                                        color: block.kind == "code" ? #c1daa6 : #e8f1e6;
                                        font-size: block.kind == "heading" ? 18px : 14px;
                                        font-weight: block.kind == "heading" ? 700 : 400;
                                        font-family: block.kind == "code" ? "Consolas" : "Segoe UI";
                                        wrap: word-wrap;
                                    }
                                    if block.has-image : Image {
                                        x: 12px;
                                        y: 12px;
                                        width: parent.width - 24px;
                                        height: parent.height - 24px;
                                        source: block.image;
                                        image-fit: contain;
                                    }
                                }
                                if interaction-method != "" : Rectangle {
                                    horizontal-stretch: 1;
                                    min-height: 130px;
                                    background: #111b17;
                                    border-width: 1px;
                                    border-color: #aaa65c;
                                    VerticalBox {
                                        padding: 12px;
                                        spacing: 8px;
                                        Text { text: "Your input is needed"; color: #f3d28a; font-size: 15px; font-weight: 700; }
                                        Text { text: pending-interaction; color: #e8f1e6; wrap: word-wrap; }
                                        response := LineEdit { placeholder-text: interaction-method == "item/tool/requestUserInput" ? "One answer per line" : "Decision"; }
                                        HorizontalBox {
                                            spacing: 6px;
                                            if interaction-method == "item/tool/requestUserInput" : Button { text: "Send answers"; enabled: response.text != ""; clicked => { answer-interaction(response.text); response.text = ""; } }
                                            if interaction-method != "item/tool/requestUserInput" : Button { text: "Approve once"; clicked => { answer-interaction("accept"); } }
                                            if interaction-method != "item/tool/requestUserInput" : Button { text: "Deny"; clicked => { answer-interaction("decline"); } }
                                            if interaction-method != "item/tool/requestUserInput" : Button { text: "Cancel work"; clicked => { answer-interaction("cancel"); } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 38px;
                        background: #1d2c23;
                        border-width: 1px;
                        border-color: #47604b;
                        HorizontalBox {
                            padding: 8px;
                            spacing: 8px;
                            Text { text: codex-status + (work-timing == "" ? "" : "  •  " + work-timing); color: #c1daa6; font-size: 12px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                            Text { text: current-session-id == "" ? "No active conversation" : current-working-directory; color: #8fa294; font-size: 11px; vertical-alignment: center; overflow: elide; }
                            if codex-status == "Codex is working..." : Button { text: "Stop"; clicked => { stop-work(); } }
                        }
                    }
                }
            }

            HorizontalBox {
                height: 92px;
                spacing: 8px;
                prompt := TextEdit {
                    vertical-stretch: 1;
                    text <=> composer-draft;
                    placeholder-text: codex-status == "Codex is working..." ? "Steer the active turn" : "Send a prompt";
                    enabled: codex-available;
                }
                VerticalBox {
                    width: 104px;
                    spacing: 8px;
                    Button { text: "Send"; height: 44px; enabled: codex-available && prompt.text != "" && !showing-archived; clicked => { submission-warning = ""; send-prompt(prompt.text, model.current-value, effort.text); } }
                    Button { text: "Timer"; height: 36px; enabled: codex-available && prompt.text != "" && current-session-id != "" && !showing-archived; clicked => { schedule-prompt(prompt.text, model.current-value, effort.text, delay.text); } }
                }
            }
            if submission-warning != "" : Text { text: submission-warning; color: #f3b8a5; wrap: word-wrap; }

            HorizontalBox {
                height: 32px;
                spacing: 8px;
                model := ComboBox { width: 220px; enabled: codex-status != "Codex is working..."; model: model-options; current-value: selected-model; selected(value) => { selected-model = value; } }
                effort := LineEdit { width: 220px; enabled: codex-status != "Codex is working..."; text: selected-effort; placeholder-text: "Reasoning effort (optional)"; edited => { selected-effort = self.text; } }
                delay := LineEdit { width: 120px; placeholder-text: "Delay seconds"; text <=> schedule-delay; }
                Button { text: "Queue"; enabled: current-session-id != ""; clicked => { reviewing-schedules = !reviewing-schedules; } }
                Text { text: model-catalog; color: #8fa294; font-size: 11px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            }
            if reviewing-schedules : GroupBox {
                title: "Pending messages for this conversation";
                ScrollView {
                    height: 100px;
                    VerticalBox {
                        for job in scheduled-items : HorizontalBox {
                            if job.conversation-id == current-session-id && job.status == "pending" : Text { text: job.due-at + " · " + job.text; color: #c1daa6; horizontal-stretch: 1; overflow: elide; }
                            if job.conversation-id == current-session-id && job.status == "pending" : Button { text: "Cancel message"; clicked => { cancel-schedule(job.id); } }
                        }
                    }
                }
            }
        }

        if current-page == "devices" : ScrollView {
            VerticalBox {
                padding: 20px;
                spacing: 12px;
                Text { text: "Connect your phone"; color: #c1daa6; font-size: 24px; font-weight: 700; }
                Text { text: "Scan the pairing QR or copy the full pairing string into the phone app. Treat an unused pairing string like a temporary password."; color: #c1daa6; wrap: word-wrap; }
                GroupBox {
                    title: "Desktop host";
                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;
                        Text { text: host-status; color: #c1daa6; }
                        Text { text: host-endpoint; color: #8fbc8f; }
                        Text { text: host-pairing; color: #f3d28a; wrap: word-wrap; }
                        Button { text: "Renew pairing"; clicked => { renew-pairing(); } }
                    }
                }
                GroupBox {
                    title: "Paired devices";
                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;
                        Text { text: current-session-id == "" ? "Select a conversation on Sessions before changing access." : "Manage access for the selected conversation."; color: #a7baa7; wrap: word-wrap; }
                        for device in host-devices : HorizontalBox {
                            spacing: 8px;
                            Text { text: device.name; color: #e8f1e6; horizontal-stretch: 1; }
                            Button { text: device.authorized ? "Remove" : "Add"; enabled: current-session-id != ""; clicked => { set-device-access(current-session-id, device.id, !device.authorized); } }
                            Button { text: "Revoke"; clicked => { revoke-device(device.id); } }
                        }
                    }
                }
            }
        }

        if current-page == "settings" : ScrollView {
            VerticalBox {
                padding: 20px;
                spacing: 12px;
                Text { text: "Desktop setup"; color: #c1daa6; font-size: 24px; font-weight: 700; }
                Text { text: "Codex and relay settings are stored on this computer."; color: #c1daa6; wrap: word-wrap; }
                GroupBox {
                    title: "Codex connection";
                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;
                        HorizontalBox {
                            spacing: 8px;
                            repository := LineEdit { text: repository-path; edited => { repository-path = self.text; } }
                            executable := LineEdit { text: codex-executable; edited => { codex-executable = self.text; } }
                            Button { text: "Connect Codex"; clicked => { connect-codex(repository.text, executable.text); } }
                        }
                        Text { text: codex-status; color: codex-available ? #c1daa6 : #f3b8a5; font-size: 14px; }
                        Text { text: usage-summary; color: #a7baa7; wrap: word-wrap; }
                    }
                }
                GroupBox {
                    title: "Optional relay";
                    VerticalBox {
                        padding: 16px;
                        spacing: 8px;
                        Text { text: relay-status; color: #a7baa7; }
                        Text { text: relay-endpoint; color: #c1daa6; }
                        Text { text: relay-enrollment; color: #f3d28a; wrap: word-wrap; }
                        HorizontalBox {
                            spacing: 8px;
                            relay-bind-field := LineEdit { text: "127.0.0.1:0"; }
                            Button { text: relay-running ? "Running" : "Start relay"; enabled: !relay-running; clicked => { start-relay(relay-bind-field.text); } }
                            Button { text: "Stop"; enabled: relay-running; clicked => { stop-relay(); } }
                        }
                        Text { text: relay-host-status; color: #a7baa7; wrap: word-wrap; }
                        relay-host-url := LineEdit { placeholder-text: "Relay URL (ws:// or wss://)"; }
                        relay-host-id := LineEdit { placeholder-text: "Relay host ID"; }
                        relay-host-token := LineEdit { placeholder-text: "Relay host token"; }
                        relay-session-key := LineEdit { placeholder-text: "Session key (<uuid>:<64 hex>)"; }
                        Button { text: "Connect this desktop through relay"; enabled: relay-host-url.text != "" && relay-host-id.text != "" && relay-host-token.text != "" && relay-session-key.text != ""; clicked => { connect-relay-host(relay-host-url.text, relay-host-id.text, relay-host-token.text, relay-session-key.text); } }
                        Button { text: "Disconnect outbound host"; enabled: relay-host-connected; clicked => { disconnect-relay-host(); } }
                    }
                }
            }
        }
    }
}
