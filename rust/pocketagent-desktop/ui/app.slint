import { Button, GroupBox, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "PocketAgent Rust Desktop";
    preferred-width: 720px;
    preferred-height: 420px;
    min-width: 560px;
    min-height: 320px;

    in-out property <string> status: "Relay is stopped";
    in-out property <string> endpoint: "No endpoint";
    in-out property <bool> relay-running: false;
    in-out property <string> codex-status: "Codex is disconnected";
    in-out property <string> transcript: "No conversation yet";
    callback start-relay();
    callback stop-relay();
    callback connect-codex(string, string);
    callback send-prompt(string);

    background: #18271f;

    VerticalBox {
        padding: 28px;
        spacing: 18px;

        Text {
            text: "PocketAgent";
            color: #c1daa6;
            font-size: 30px;
            font-weight: 700;
        }
        Text {
            text: "Rust desktop MVP";
            color: #a7b7aa;
            font-size: 16px;
        }

        GroupBox {
            title: "Local relay";
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                Text { text: status; color: #e8f1e6; font-size: 16px; }
                Text { text: endpoint; color: #c1daa6; font-size: 14px; }
            }
        }

        GroupBox {
            title: "Codex conversation";
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                HorizontalBox {
                    spacing: 8px;
                    repository := LineEdit { placeholder-text: "Repository directory"; }
                    executable := LineEdit { text: "codex"; placeholder-text: "Codex executable"; }
                    Button {
                        text: "Connect Codex";
                        clicked => { connect-codex(repository.text, executable.text); }
                    }
                }
                Text { text: codex-status; color: #c1daa6; font-size: 14px; }
                Text { text: transcript; color: #e8f1e6; font-size: 14px; vertical-alignment: center; }
                HorizontalBox {
                    spacing: 8px;
                    prompt := LineEdit { placeholder-text: "Send a prompt"; enabled: codex-status == "Codex is ready"; }
                    Button {
                        text: "Send";
                        enabled: codex-status == "Codex is ready" && prompt.text != "";
                        clicked => { send-prompt(prompt.text); prompt.text = ""; }
                    }
                }
            }
        }

        HorizontalBox {
            spacing: 12px;
            Button {
                text: relay-running ? "Running" : "Start relay";
                enabled: !relay-running;
                clicked => { start-relay(); }
            }
            Button {
                text: "Stop";
                enabled: relay-running;
                clicked => { stop-relay(); }
            }
        }
        Text {
            text: "Basic Codex prompts are wired locally; approvals and mobile adapters remain next.";
            color: #8fa294;
            font-size: 13px;
        }
    }
}
