import { Button, GroupBox, HorizontalBox, LineEdit, VerticalBox } from "std-widgets.slint";

export struct MarkdownBlock {
    text: string,
    kind: string,
}

export struct SessionItem {
    id: string,
    title: string,
}

export component AppWindow inherits Window {
    title: "PocketAgent Rust Desktop";
    preferred-width: 820px;
    preferred-height: 680px;
    min-width: 640px;
    min-height: 480px;

    in-out property <string> repository-path: "";
    in-out property <string> codex-executable: "codex";
    in-out property <string> codex-status: "Codex is disconnected";
    in-out property <[SessionItem]> session-items: [];
    in-out property <string> current-session-id: "";
    in-out property <bool> showing-archived: false;
    in-out property <string> pending-interaction: "";
    in-out property <string> interaction-method: "";
    in-out property <string> interaction-decisions: "";
    in-out property <string> model-catalog: "Provider model catalog unavailable";
    in-out property <string> usage-summary: "Usage unavailable";
    in-out property <[MarkdownBlock]> transcript-blocks: [];
    in-out property <string> relay-status: "Relay is stopped";
    in-out property <string> relay-endpoint: "No endpoint";
    in-out property <bool> relay-running: false;
    callback connect-codex(string, string);
    callback new-conversation(string, string);
    callback refresh-sessions();
    callback select-session(string);
    callback archive-session();
    callback restore-session();
    callback toggle-pin();
    callback rename-session(string);
    callback toggle-archived();
    callback answer-interaction(string);
    callback send-prompt(string, string, string);
    callback stop-work();
    callback start-relay(string);
    callback stop-relay();

    background: #18271f;

    VerticalBox {
        padding: 28px;
        spacing: 18px;

        Text {
            text: "PocketAgent";
            color: #c1daa6;
            font-size: 30px;
            font-weight: 700;
        }
        Text {
            text: "Local desktop mode";
            color: #a7b7aa;
            font-size: 16px;
        }

        GroupBox {
            title: "Codex connection";
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                HorizontalBox {
                    spacing: 8px;
                    repository := LineEdit { text: repository-path; edited => { repository-path = self.text; } }
                    executable := LineEdit { text: codex-executable; edited => { codex-executable = self.text; } }
                    Button {
                        text: "Connect Codex";
                        clicked => { connect-codex(repository.text, executable.text); }
                    }
                }
                Text { text: codex-status; color: #c1daa6; font-size: 14px; }
                Text { text: usage-summary; color: #a7b7aa; font-size: 13px; }
            }
        }

        GroupBox {
            title: "Sessions";
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                for session in session-items : Button {
                    text: session.title;
                    clicked => { select-session(session.id); }
                }
                HorizontalBox {
                    spacing: 8px;
                    Button { text: "New conversation"; enabled: codex-status == "Codex is ready"; clicked => { new-conversation(model.text, effort.text); } }
                    Button { text: "Refresh"; enabled: codex-status == "Codex is ready"; clicked => { refresh-sessions(); } }
                    Button { text: showing-archived ? "Active" : "Archived"; clicked => { toggle-archived(); } }
                    Button { text: "Pin / unpin"; enabled: current-session-id != ""; clicked => { toggle-pin(); } }
                    Button { text: showing-archived ? "Restore" : "Archive"; enabled: current-session-id != ""; clicked => { if (showing-archived) { restore-session(); } else { archive-session(); } } }
                }
                HorizontalBox {
                    spacing: 8px;
                    rename := LineEdit { placeholder-text: "Rename selected conversation"; }
                    Button { text: "Rename"; enabled: current-session-id != "" && rename.text != ""; clicked => { rename-session(rename.text); rename.text = ""; } }
                }
            }
        }

        GroupBox {
            title: "Conversation";
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                for block in transcript-blocks : Text {
                    text: block.text;
                    color: block.kind == "code" ? #c1daa6 : #e8f1e6;
                    font-size: block.kind == "heading" ? 18px : 14px;
                    font-weight: block.kind == "heading" ? 700 : 400;
                    font-family: block.kind == "code" ? "Consolas" : "Segoe UI";
                }
                if interaction-method != "" : GroupBox {
                    title: "Codex needs your input";
                    VerticalBox {
                        spacing: 8px;
                        Text { text: pending-interaction; color: #f3d28a; font-size: 14px; }
                        response := LineEdit { placeholder-text: interaction-method == "item/tool/requestUserInput" ? "One answer per line" : "Decision"; }
                        HorizontalBox {
                            spacing: 8px;
                            if interaction-method == "item/tool/requestUserInput" : Button { text: "Submit"; enabled: response.text != ""; clicked => { answer-interaction(response.text); response.text = ""; } }
                            if interaction-method != "item/tool/requestUserInput" : Button { text: "Accept"; clicked => { answer-interaction("accept"); } }
                            if interaction-method != "item/tool/requestUserInput" : Button { text: "Decline"; clicked => { answer-interaction("decline"); } }
                            if interaction-method != "item/tool/requestUserInput" : Button { text: "Cancel"; clicked => { answer-interaction("cancel"); } }
                        }
                    }
                }
                HorizontalBox {
                    spacing: 8px;
                    model := LineEdit { placeholder-text: "Model slug (optional)"; }
                    effort := LineEdit { placeholder-text: "Reasoning effort (optional)"; }
                }
                Text { text: model-catalog; color: #8fa294; font-size: 12px; wrap: word-wrap; }
                HorizontalBox {
                    spacing: 8px;
                    prompt := LineEdit { placeholder-text: "Send a prompt"; enabled: codex-status == "Codex is ready"; }
                    Button {
                        text: "Send";
                        enabled: codex-status == "Codex is ready" && prompt.text != "";
                        clicked => { send-prompt(prompt.text, model.text, effort.text); prompt.text = ""; }
                    }
                    Button {
                        text: "Stop";
                        enabled: codex-status == "Codex is working...";
                        clicked => { stop-work(); }
                    }
                }
            }
        }

        GroupBox {
            title: "Optional relay";
            VerticalBox {
                padding: 16px;
                spacing: 8px;
                Text { text: relay-status; color: #a7b7aa; font-size: 13px; }
                Text { text: relay-endpoint; color: #c1daa6; font-size: 13px; }
                HorizontalBox {
                    spacing: 8px;
                    relay-bind-field := LineEdit { placeholder-text: "Relay bind address"; text: "127.0.0.1:0"; }
                    Button { text: relay-running ? "Running" : "Start relay"; enabled: !relay-running; clicked => { start-relay(relay-bind-field.text); } }
                    Button { text: "Stop"; enabled: relay-running; clicked => { stop-relay(); } }
                }
            }
        }

        Text {
            text: "Local Codex mode does not require a relay. Approval handling and mobile adapters remain next.";
            color: #8fa294;
            font-size: 13px;
        }
    }
}
