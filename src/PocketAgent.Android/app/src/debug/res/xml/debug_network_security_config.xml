<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- Same owner-installed LAN CA policy as release; HTTP exceptions below are debug only. -->
    <base-config cleartextTrafficPermitted="false"><trust-anchors><certificates src="system"/><certificates src="user" tools:ignore="AcceptsUserCertificates"/></trust-anchors></base-config>
    <domain-config cleartextTrafficPermitted="true"><domain includeSubdomains="false">10.0.2.2</domain><domain includeSubdomains="false">127.0.0.1</domain><domain includeSubdomains="false">localhost</domain></domain-config>
</network-security-config>
