<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!-- LAN hosts use a private CA explicitly installed by this phone's owner. Never disable TLS validation. -->
    <base-config cleartextTrafficPermitted="false"><trust-anchors><certificates src="system"/><certificates src="user" tools:ignore="AcceptsUserCertificates"/></trust-anchors></base-config>
</network-security-config>
