<Application x:Class="PocketAgent.Desktop.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <DataTemplate x:Key="EditIconTemplate"><Viewbox Width="18" Height="18"><Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" Data="M3,17.25 V21 H6.75 L17.81,9.94 L14.06,6.19 L3,17.25 Z M20.71,7.04 C21.1,6.65 21.1,6.02 20.71,5.63 L18.37,3.29 C17.98,2.9 17.35,2.9 16.96,3.29 L15.13,5.12 L18.88,8.87 L20.71,7.04 Z"/></Viewbox></DataTemplate>
    <DataTemplate x:Key="RobotIconTemplate"><Viewbox Width="18" Height="18"><Canvas Width="24" Height="24"><Path Fill="Transparent" Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.8" Data="M8,7 H16 C18.2,7 20,8.8 20,11 V14 C20,16.2 18.2,18 16,18 H8 C5.8,18 4,16.2 4,14 V11 C4,8.8 5.8,7 8,7 Z"/><Path Stroke="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" StrokeThickness="1.8" StrokeStartLineCap="Round" Data="M12,7 V4"/><Ellipse Fill="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" Width="2.5" Height="2.5" Canvas.Left="10.75" Canvas.Top="1.85"/><Ellipse Fill="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" Width="2.5" Height="2.5" Canvas.Left="7.25" Canvas.Top="11.25"/><Ellipse Fill="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" Width="2.5" Height="2.5" Canvas.Left="14.25" Canvas.Top="11.25"/></Canvas></Viewbox></DataTemplate>
    <DataTemplate x:Key="PinIconTemplate"><Viewbox Width="18" Height="18"><Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" Data="M16,3 L18,5 L16,7 L17,11 L20,14 L19,15 L13,14 L9,18 L8,17 L12,13 L11,7 L9,5 L10,3 Z M12,14 L13,15 L9,19 L8,18 Z"/></Viewbox></DataTemplate>
    <DataTemplate x:Key="ArchiveIconTemplate"><Viewbox Width="18" Height="18"><Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" Data="M20.54,5.23 L19.15,3.55 C18.85,3.21 18.45,3 18,3 H6 C5.55,3 5.15,3.21 4.85,3.55 L3.46,5.23 C3.17,5.57 3,6.02 3,6.5 V19 C3,20.1 3.9,21 5,21 H19 C20.1,21 21,20.1 21,19 V6.5 C21,6.02 20.83,5.57 20.54,5.23 Z M5.12,5 L5.93,4 H18.07 L18.88,5 H5.12 Z M12,18 L8,14 H11 V11 H13 V14 H16 L12,18 Z"/></Viewbox></DataTemplate>
    <DataTemplate x:Key="UnarchiveIconTemplate"><Viewbox Width="18" Height="18"><Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" Data="M20.54,5.23 L19.15,3.55 C18.85,3.21 18.45,3 18,3 H6 C5.55,3 5.15,3.21 4.85,3.55 L3.46,5.23 C3.17,5.57 3,6.02 3,6.5 V19 C3,20.1 3.9,21 5,21 H19 C20.1,21 21,20.1 21,19 V6.5 C21,6.02 20.83,5.57 20.54,5.23 Z M5.12,5 L5.93,4 H18.07 L18.88,5 H5.12 Z M12,8 L16,12 H13 V15 H11 V12 H8 L12,8 Z"/></Viewbox></DataTemplate>
    <DataTemplate x:Key="StopIconTemplate"><Viewbox Width="18" Height="18"><Path Fill="{Binding RelativeSource={RelativeSource AncestorType=Button},Path=Foreground}" Data="M6,6 H18 V18 H6 Z"/></Viewbox></DataTemplate>
    <Style TargetType="Window"><Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/><Setter Property="Background" Value="#111B17"/><Setter Property="Foreground" Value="#EBF1EA"/><EventSetter Event="Loaded" Handler="WindowLoaded"/></Style>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/><Setter Property="Background" Value="#294333"/><Setter Property="Foreground" Value="#C1DAA6"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter x:Name="ButtonContent" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="#2D4936"/><Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="#EBF1EA"/></Trigger><MultiTrigger><MultiTrigger.Conditions><Condition Property="IsMouseOver" Value="True"/><Condition Property="Background" Value="#C1DAA6"/></MultiTrigger.Conditions><Setter TargetName="ButtonSurface" Property="Background" Value="#B4CC99"/><Setter TargetName="ButtonContent" Property="TextElement.Foreground" Value="#111B17"/></MultiTrigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#C1DAA6"/><Setter TargetName="ButtonSurface" Property="BorderThickness" Value="1"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="Margin" Value="0,5,0,12"/><Setter Property="Background" Value="#213128"/><Setter Property="Foreground" Value="#EBF1EA"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#47604B"/></Style>
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="#C1DAA6"/></Style>
    <Style TargetType="TabControl">
      <Setter Property="Background" Value="#111B17"/><Setter Property="Foreground" Value="#C1DAA6"/><Setter Property="BorderBrush" Value="#111B17"/><Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="TabControl">
          <Grid Background="{TemplateBinding Background}" KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <TabPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True" KeyboardNavigation.TabIndex="1" Background="{TemplateBinding Background}"/>
            <Border Grid.Row="1" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
            </Border>
          </Grid>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TabItem">
      <Setter Property="Padding" Value="20,10"/><Setter Property="Foreground" Value="#C1DAA6"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
        <Border x:Name="TabSurface" Background="#18271F" Padding="{TemplateBinding Padding}" Margin="0,0,4,0"><ContentPresenter ContentSource="Header"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#294333"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabSurface" Property="Background" Value="#34523C"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#C1DAA6"/><Setter Property="Background" Value="#213128"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
        <Grid><ToggleButton Focusable="False" Background="#213128" Foreground="#C1DAA6" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
          <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="#47604B" BorderThickness="1" Padding="10"><DockPanel><TextBlock DockPanel.Dock="Right" Text=" ▾"/><ContentPresenter Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"/></DockPanel></Border></ControlTemplate></ToggleButton.Template>
        </ToggleButton>
        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#213128" BorderBrush="#47604B" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="320"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
        </Grid>
        <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#C1DAA6"/><Setter Property="Padding" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemSurface" Background="#213128" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#34523C"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#294333"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListBox"><Setter Property="Background" Value="#18271F"/><Setter Property="Foreground" Value="#C1DAA6"/><Setter Property="BorderBrush" Value="#47604B"/></Style>
    <Style TargetType="ListBoxItem" x:Key="ReadableListItem"><Setter Property="Foreground" Value="#C1DAA6"/><Setter Property="Padding" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemSurface" Background="#18271F" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemSurface" Property="Background" Value="#34523C"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ReadableListItem}"/>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#C1DAA6"/></Style>
    <Style TargetType="Expander"><Setter Property="Foreground" Value="#C1DAA6"/></Style>
    <Style TargetType="PasswordBox"><Setter Property="Foreground" Value="#EBF1EA"/><Setter Property="Background" Value="#213128"/><Setter Property="CaretBrush" Value="White"/><Setter Property="Padding" Value="10"/></Style>
    <Style TargetType="ToolTip"><Setter Property="Foreground" Value="#C1DAA6"/><Setter Property="Background" Value="#213128"/></Style>
    <Style TargetType="ScrollViewer"><Setter Property="Background" Value="#111B17"/><Setter Property="BorderBrush" Value="#111B17"/><Setter Property="BorderThickness" Value="0"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
    <Style TargetType="DatePicker"><Setter Property="Foreground" Value="#EBF1EA"/><Setter Property="Background" Value="#213128"/><Setter Property="BorderBrush" Value="#47604B"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="Calendar"><Setter Property="Foreground" Value="#C1DAA6"/><Setter Property="Background" Value="#213128"/><Setter Property="BorderBrush" Value="#47604B"/><Setter Property="BorderThickness" Value="1"/></Style>
    <Style TargetType="Thumb" x:Key="DarkScrollThumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border x:Name="Surface" Background="#47604B" CornerRadius="4" Margin="2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#789078"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="Surface" Property="Background" Value="#A7BAA7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="RepeatButton" x:Key="DarkScrollPage"><Setter Property="Focusable" Value="False"/><Setter Property="IsTabStop" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="#18271F"/><Setter Property="Width" Value="14"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
        <Border Background="{TemplateBinding Background}"><Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="{TemplateBinding Orientation}">
          <Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Style="{StaticResource DarkScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
          <Track.Thumb><Thumb Style="{StaticResource DarkScrollThumb}"/></Track.Thumb>
          <Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Style="{StaticResource DarkScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
        </Track></Border>
        <ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="14"/>
          <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/>
          <Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/>
          <Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/>
        </Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Application.Resources>
</Application>
