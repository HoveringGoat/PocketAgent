<Window x:Class="PocketAgent.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PocketAgent" Width="1150" Height="820" MinWidth="800" MinHeight="580" Closing="WindowClosing" Background="#111B17" Foreground="#EBF1EA">
  <Grid x:Name="RootLayout" Margin="22" Background="#111B17" TextElement.Foreground="#C1DAA6">
    <Grid.LayoutTransform><ScaleTransform x:Name="UiScaleTransform" ScaleX="1" ScaleY="1"/></Grid.LayoutTransform>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,6" VerticalAlignment="Center">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid Margin="0,0,6,0" VerticalAlignment="Center">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <TextBlock Text="PocketAgent" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
          <TextBlock FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"><Run x:Name="ServerNameDisplay" Foreground="#A7BAA7"/><Run Text=" · " Foreground="#53665A"/><Run x:Name="ConversationLocation" Foreground="#8FBC8F"/></TextBlock>
          <TextBlock x:Name="UsageDisplay" Foreground="#C1DAA6" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </StackPanel>
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="SessionsNavButton" Content="Sessions" Tag="0" Click="SelectNavigation" Padding="16,10" Margin="4" MinWidth="96"/><Button x:Name="DevicesNavButton" Content="Devices" Tag="1" Click="SelectNavigation" Padding="16,10" Margin="4" MinWidth="96"/><Button x:Name="SettingsNavButton" Content="Settings" Tag="2" Click="SelectNavigation" Padding="16,10" Margin="4" MinWidth="96"/><ToggleButton x:Name="ServerToggle" Content="OFF" IsChecked="False" IsThreeState="False" Click="ToggleServer" ToolTip="ON starts the local PocketAgent server; OFF stops it." AutomationProperties.Name="Server power switch" AutomationProperties.HelpText="ON means the server is running; OFF means it is stopped." Width="64" Height="26" Margin="6,0,0,0" VerticalAlignment="Center" Cursor="Hand">
        <ToggleButton.Style>
          <Style TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
              <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                  <Grid Width="64" Height="26">
                    <!-- One recessed track and a matte knob; illumination stays inside the rim. -->
                    <Border CornerRadius="13" Background="#0C1410" BorderThickness="1" BorderBrush="#46544A">
                      <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="3" ShadowDepth="1" Opacity="0.35"/></Border.Effect>
                    </Border>
                    <Border x:Name="Track" Margin="2" CornerRadius="11">
                      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#111914" Offset="0"/><GradientStop Color="#202C24" Offset="1"/></LinearGradientBrush></Border.Background>
                    </Border>
                    <TextBlock x:Name="StateLabel" Text="OFF" Width="34" TextAlignment="Center" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,3,0" Foreground="#A7B5AA" FontWeight="Medium" FontSize="11"/>
                    <Border x:Name="Knob" Width="20" Height="20" CornerRadius="10" BorderThickness="0.75" BorderBrush="#C0CCC0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0">
                      <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
                      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#D1DACF" Offset="0"/><GradientStop Color="#B4C0B2" Offset="1"/></LinearGradientBrush></Border.Background>
                      <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="2" ShadowDepth="1" Opacity="0.45"/></Border.Effect>
                    </Border>
                    <Border x:Name="FocusRing" Margin="-2" CornerRadius="15" BorderBrush="#C1DAA6" BorderThickness="1" Visibility="Collapsed"/>
                  </Grid>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Track" Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#355C36" Offset="0"/><GradientStop Color="#4E7845" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
                      <Setter TargetName="StateLabel" Property="HorizontalAlignment" Value="Left"/>
                      <Setter TargetName="StateLabel" Property="Margin" Value="3,0,0,0"/>
                      <Setter TargetName="StateLabel" Property="Text" Value="ON"/>
                      <Setter TargetName="StateLabel" Property="Foreground" Value="#F0FADF"/>
                      <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="38" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                      <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Knob" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Knob" Property="Opacity" Value="0.8"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Setter.Value>
            </Setter>
            <Style.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.65"/></Trigger>
            </Style.Triggers>
          </Style>
        </ToggleButton.Style>
      </ToggleButton></StackPanel>
    </Grid>
    <TabControl x:Name="Navigation" Grid.Row="1" Background="Transparent" BorderThickness="0"
                HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                SelectionChanged="NavigationSelectionChanged">
      <TabItem Header="Sessions">
        <Grid Margin="0,16,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Content="+" AutomationProperties.Name="New conversation" ToolTip="New conversation" Click="NewConversation"/>
              <StackPanel x:Name="ConversationActions" Orientation="Horizontal" IsEnabled="False">
                <Button x:Name="EditConversationButton" Content="" ContentTemplate="{StaticResource EditIconTemplate}" ToolTip="Edit conversation" AutomationProperties.Name="Edit conversation" Click="EditConversation" MinWidth="34" Height="32" Padding="4,2" Foreground="#C1DAA6"/>
                <Button x:Name="ModelButton" Content="" ContentTemplate="{StaticResource RobotIconTemplate}" ToolTip="Model and reasoning" AutomationProperties.Name="Model and reasoning" Click="ChangeModel" MinWidth="34" Height="32" Padding="4,2" Foreground="#C1DAA6"/>
                <Button x:Name="ArchiveButton" Content="" ContentTemplate="{StaticResource ArchiveIconTemplate}" ToolTip="Archive conversation" AutomationProperties.Name="Archive conversation" Click="ArchiveConversation" MinWidth="34" Height="32" Padding="4,2" Foreground="#C1DAA6"/>
                <Button x:Name="ArchivedButton" Content="" ContentTemplate="{StaticResource UnarchiveIconTemplate}" ToolTip="View archived conversations" AutomationProperties.Name="View archived conversations" Click="ShowArchived" MinWidth="34" Height="32" Padding="4,2" Foreground="#C1DAA6"/>
              </StackPanel>
            </StackPanel>
            <ListBox x:Name="SessionList" Background="#18271F" Foreground="#EBF1EA" BorderThickness="0" DisplayMemberPath="Label" SelectionChanged="SessionSelected" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource ReadableListItem}"><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style></ListBox.ItemContainerStyle>
            </ListBox>
          </DockPanel>
          <Grid Grid.Row="1" x:Name="ConversationPanel" IsEnabled="False">
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <ScrollViewer x:Name="TranscriptScroll" Margin="0,8" ScrollChanged="TranscriptScrollChanged"><StackPanel x:Name="Transcript" TextElement.Foreground="#C1DAA6"/></ScrollViewer>
              <Button Grid.Row="1" x:Name="JumpToLatestButton" Content="Jump to latest ↓" AutomationProperties.Name="Jump to latest messages" Click="JumpToLatest" Visibility="Collapsed" HorizontalAlignment="Right" FontSize="12" Padding="8,4" Margin="0,0,14,4"/>
            </Grid>
            <!-- Native equivalent of conversation-meta: outside the transcript, immediately above input. -->
            <Border Grid.Row="1" x:Name="ConversationMetaSurface" Height="38" MinHeight="38" Background="#1D2C23" BorderBrush="#47604B" BorderThickness="1" Padding="8,5" Margin="0,0,0,4">
              <DockPanel><Button DockPanel.Dock="Right" x:Name="InterruptButton" Content="" ContentTemplate="{StaticResource StopIconTemplate}" ToolTip="Stop work" AutomationProperties.Name="Stop" Click="InterruptWork" Visibility="Hidden" MinWidth="30" Width="30" Height="26" Padding="3" Margin="0" VerticalAlignment="Center" Background="Transparent" Foreground="#C1DAA6"/><TextBlock x:Name="ConversationMeta" Text="No active conversation" FontSize="12" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Foreground="#C1DAA6"/></DockPanel>
            </Border>
            <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="Composer" AutomationProperties.Name="Message Codex" MinHeight="72" MaxHeight="180" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" TextChanged="DraftChanged" PreviewKeyDown="ComposerKeyDown"/>
              <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="8,0,0,12">
                <Button x:Name="SendButton" Content="Send" Click="SendMessage" Background="#C1DAA6" Foreground="#111B17" MinWidth="104"><Button.ContentTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="NoWrap" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"/></DataTemplate></Button.ContentTemplate></Button>
                <Button x:Name="ScheduleButton" Content="&#x23F1;&#xFE0E;" ToolTip="Schedule message" AutomationProperties.Name="Schedule message" Click="ScheduleMessage" Foreground="#C1DAA6" FontFamily="Segoe UI Symbol" Width="38" MinWidth="38" Height="38" Padding="4" FontSize="18"/>
                <Button x:Name="ScheduledSummaryButton" Visibility="Collapsed" Click="ShowScheduled"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
      </TabItem>
      <TabItem Header="Devices">
        <ScrollViewer><StackPanel Margin="20" MaxWidth="730" HorizontalAlignment="Left">
          <TextBlock Text="Connect your phone" FontSize="24"/><TextBlock Text="Scan this QR or copy its full pairing string into the phone app. Either method verifies this desktop and pairs the phone in one step. Treat an unused QR or pairing string like a temporary password." Margin="0,10"/>
          <TextBlock x:Name="CertificateStatus" TextWrapping="Wrap" Foreground="#C1DAA6"/>
          <TextBox x:Name="ConnectionAddress" IsReadOnly="True"/><Button Content="Copy address" Click="CopyAddress" HorizontalAlignment="Left"/>
          <Button Content="Connection diagnostics" Click="CheckConnectivity" HorizontalAlignment="Left"/>
          <Button Content="Locate Android installer APK" Click="LocateAndroid" HorizontalAlignment="Left"/>
          <Image x:Name="PairingQr" Width="360" Height="360" Stretch="Uniform" HorizontalAlignment="Left" Margin="0,16" RenderOptions.BitmapScalingMode="NearestNeighbor" AutomationProperties.Name="Desktop pairing QR"/>
          <TextBlock x:Name="PairingDisplay" FontSize="20" Margin="0,8,0,4"/><TextBlock x:Name="PairingExpiry"/>
          <WrapPanel><Button Content="Copy pairing string" Click="CopyPairing"/><Button Content="Generate new pairing QR" Click="RenewPairing"/></WrapPanel>
           <TextBlock Text="Paired devices" FontSize="21" Margin="0,24,0,10"/><TextBlock x:Name="DeviceAccessStatus" Text="Open Edit conversation to manage device access." Foreground="#A7BAA7" TextWrapping="Wrap" Margin="0,0,0,8"/><StackPanel x:Name="DeviceList"/>
        </StackPanel></ScrollViewer>
      </TabItem>
      <TabItem Header="Settings">
        <ScrollViewer><StackPanel Margin="20" MaxWidth="760" HorizontalAlignment="Left">
          <TextBlock Text="Desktop setup" FontSize="24"/><TextBlock Text="Save settings while the server is stopped. Credentials stay on this computer." Margin="0,8,0,18"/>
          <TextBlock x:Name="BuildDisplay" Foreground="#A7BAA7" Margin="0,0,0,14" TextWrapping="Wrap"/>
          <TextBlock Text="Startup and updates" FontSize="20" Margin="0,10,0,4"/>
          <TextBlock Text="Appearance" FontSize="20" Margin="0,10,0,4"/>
          <TextBlock Text="Font and UI size"/>
          <ComboBox x:Name="UiScaleSetting" SelectedValuePath="Tag" SelectionChanged="UiScaleChanged" Padding="10" Margin="0,5,0,12">
            <ComboBoxItem Content="Compact (90%)" Tag="compact"/>
            <ComboBoxItem Content="Comfortable (100%, default)" Tag="comfortable"/>
            <ComboBoxItem Content="Plus (110%)" Tag="plus"/>
            <ComboBoxItem Content="Large (120%)" Tag="large"/>
          </ComboBox>
          <CheckBox x:Name="StartServerOnLaunchSetting" Content="Start server when PocketAgent opens"/>
          <CheckBox x:Name="LaunchOnWindowsStartupSetting" Content="Launch PocketAgent when I sign in to Windows"/>
          <CheckBox x:Name="CheckUpdatesOnStartupSetting" Content="Check for updates when PocketAgent starts"/>
          <CheckBox x:Name="CheckUpdatesPeriodicallySetting" Content="Check periodically while PocketAgent is running"/>
          <CheckBox x:Name="AutomaticUpdatesSetting" Content="Install updates automatically during a safe idle window"/>
           <CheckBox x:Name="HeartbeatSetting" Content="Send a hidden progress update every five minutes while a conversation is working"/>
          <TextBlock x:Name="UpdateStatus" Foreground="#A7BAA7" Margin="0,4,0,4" TextWrapping="Wrap"/>
          <WrapPanel><Button Content="Check for updates now" Click="CheckForUpdates"/><Button Content="View release notes" x:Name="UpdateNotesButton" Visibility="Collapsed" Click="ViewReleaseNotes"/><Button Content="Download and install update" Click="InstallUpdate"/></WrapPanel>
          <TextBlock Text="Default working folder (new conversations can choose another)"/><DockPanel><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseRepository"/><TextBox x:Name="RepositorySetting" MinWidth="430"/></DockPanel>
          <TextBlock Text="Codex executable override (leave blank to prefer VS Code)"/><TextBox x:Name="CodexSetting"/><TextBlock x:Name="CodexResolved" Foreground="#A7BAA7" Margin="0,0,0,14"/>
          <TextBlock Text="Codex permissions"/>
          <ComboBox x:Name="PermissionModeSetting" SelectedValuePath="Tag" Padding="10" Margin="0,5,0,8" AutomationProperties.Name="Codex permissions">
            <ComboBoxItem Content="Use Codex settings" Tag="inherit"/>
            <ComboBoxItem Content="Ask for approval" Tag="ask"/>
            <ComboBoxItem Content="Full access" Tag="full-access"/>
          </ComboBox>
          <TextBlock Text="Full access permits filesystem and network actions without command approvals. Save while stopped, then start the server. Applies to new and resumed PocketAgent conversations; managed restrictions remain authoritative." Foreground="#A7BAA7" Margin="0,0,0,16"/>
          <TextBlock Text="Listener IPv4 address / port"/><DockPanel><TextBox x:Name="PortSetting" DockPanel.Dock="Right" Width="90" Margin="10,5,0,12"/><TextBox x:Name="AddressSetting"/></DockPanel>
          <Button Content="Set up direct internet (IP + port)…" Click="SetupDirectInternet" HorizontalAlignment="Left"/>
          <TextBlock Text="Direct internet HTTPS address (public IPv4 + external port)"/><TextBox x:Name="DirectOriginSetting"/>
          <TextBlock Text="Forward only your chosen chat TCP port to the desktop listener. Scan the pairing QR or paste its string on the phone. No certificate installation, ports 80/443 or changes to Caddy are needed." TextWrapping="Wrap" Margin="0,0,0,12"/>
          <Expander Header="Advanced certificate settings" Margin="0,10">
            <StackPanel>
              <TextBlock Text="Server certificate PFX path (managed by trusted HTTPS setup)"/><TextBox x:Name="CertificateSetting"/>
              <Button Content="Set up Wi-Fi connection…" Click="SetupWifi" HorizontalAlignment="Left"/>
              <TextBlock Text="Use a private LAN address and pair by QR or pairing string. The phone trusts only this desktop's key; no CA installation is needed." Foreground="#A7BAA7"/>
            </StackPanel>
          </Expander>
          <StackPanel x:Name="RelaySetupSection" Margin="0,10,0,12">
            <TextBlock Text="Relay mode"/>
            <ComboBox x:Name="RelayModeSetting" SelectedValuePath="Tag" SelectionChanged="RelayModeChanged" AutomationProperties.Name="Relay mode" Margin="0,5,0,6">
              <ComboBoxItem Content="Off" Tag="off"/>
              <ComboBoxItem Content="Host relay node" Tag="host"/>
              <ComboBoxItem Content="Connect to relay" Tag="client"/>
            </ComboBox>
            <TextBlock x:Name="RelayServerOffNotice" Text="Turn the server OFF to enable a relay mode or change relay settings." Foreground="#A7BAA7" TextWrapping="Wrap"/>
            <StackPanel x:Name="RelayHostPanel" Visibility="Collapsed" Margin="0,10,0,0">
              <TextBlock x:Name="RelayNodeStatus" AutomationProperties.LiveSetting="Polite"/>
              <TextBlock x:Name="RelayNodeAddressHint" Visibility="Collapsed" Foreground="#A7BAA7" Margin="0,4,0,0"
                         Text="This address works on this computer only. Set up Wi-Fi or direct internet on this desktop to connect from another machine."/>
              <TextBlock Text="On the other desktop, choose Connect to relay and paste the client enrollment. Share it privately." Foreground="#A7BAA7" Margin="0,4,0,0"/>
              <Button x:Name="CopyRelayEnrollmentButton" Content="Copy client enrollment" Click="CopyRelayEnrollment" HorizontalAlignment="Left"/>
              <Expander Header="Advanced .NET client setup" Margin="0,4,0,0">
                <StackPanel>
                  <TextBlock Text="A custom .NET client uses these credentials and a device pairing ticket from the connected desktop. The Android app uses direct pairing." Foreground="#A7BAA7"/>
                  <Button x:Name="CopyRelayClientButton" Content="Copy .NET client credentials" Click="CopyRelayClientSetup" HorizontalAlignment="Left"/>
                </StackPanel>
              </Expander>
            </StackPanel>
            <StackPanel x:Name="RelayClientPanel" Visibility="Collapsed" Margin="0,10,0,0">
              <TextBlock x:Name="RelayUpstreamStatus" AutomationProperties.LiveSetting="Polite"/>
              <StackPanel x:Name="RelayEnrollmentPanel" Margin="0,4,0,0">
                <TextBlock Text="Client enrollment"/>
                <PasswordBox x:Name="RelayEnrollmentSetting" AutomationProperties.Name="Client enrollment" PasswordChanged="RelayEnrollmentChanged" Margin="0,5,0,6"/>
                <TextBlock Text="On the relay node, select Copy client enrollment. Paste the full string here." Foreground="#A7BAA7"/>
              </StackPanel>
              <WrapPanel>
                <Button x:Name="SaveRelayEnrollmentButton" Content="Save enrollment" Click="SaveRelayEnrollment"/>
                <Button x:Name="ReplaceRelayEnrollmentButton" Content="Replace enrollment" Click="ReplaceRelayEnrollment"/>
                <Button x:Name="UnenrollRelayButton" Content="Unenroll" Click="UnenrollRelay"/>
              </WrapPanel>
              <Expander x:Name="RelayClientAdvanced" Header="Advanced .NET client pairing" Visibility="Collapsed" Margin="0,4,0,0">
                <StackPanel>
                  <TextBlock Text="A custom .NET client uses a one-time device pairing ticket to access this desktop through the relay." Foreground="#A7BAA7"/>
                  <Button x:Name="CopyRelayDeviceTicketButton" Content="Copy device pairing ticket" Click="CopyRelayDeviceTicket" HorizontalAlignment="Left"/>
                </StackPanel>
              </Expander>
            </StackPanel>
          </StackPanel>
          <WrapPanel><Button x:Name="SaveButton" Content="Save settings" Click="SaveSettings"/><Button Content="Check Codex sign-in" Click="CheckProvider"/><Button Content="Open setup guide" Click="OpenGuide"/></WrapPanel>
          <TextBlock x:Name="ProviderDisplay" Margin="0,12" Foreground="#C1DAA6"/>
        </StackPanel></ScrollViewer>
      </TabItem>
    </TabControl>
    <TextBlock x:Name="ErrorDisplay" Grid.Row="2" Foreground="#F3B8A5" Margin="0,12,0,0" AutomationProperties.LiveSetting="Polite"/>
  </Grid>
</Window>
